# Environment variables — NEVER commit these
.env
.env.local
.env.*.local

# Expo
.expo/
dist/
web-build/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# EAS build
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*google-services.json
src/assets/logo_original_backup.png
src/assets/apple-music-logo_backup.jpg
