{
  "functions": {
    "api/ai.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/email.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/cron/digest.js": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/digest?tz=ET", "schedule": "0 11 * * *" },
    { "path": "/api/cron/digest?tz=CT", "schedule": "0 12 * * *" },
    { "path": "/api/cron/digest?tz=MT", "schedule": "0 13 * * *" },
    { "path": "/api/cron/digest?tz=PT", "schedule": "0 14 * * *" }
  ]
}
