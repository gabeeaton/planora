{
  "expo": {
    "name": "Planora",
    "slug": "planora",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planoraapp",
      "icon": "./icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification", 
          "fetch"
        ],
        "NSUserTrackingUsageDescription": "Planora does not track you across other apps or websites.",
        "NSCameraUsageDescription": "Planora uses your camera to scan and import your course syllabus.",
        "NSPhotoLibraryUsageDescription": "Planora accesses your photo library so you can import a syllabus image."
      },
      "scheme": "planora"
    },
    "android": {
      "package": "com.planora.app",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "planora"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "scheme": "planora",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#6C63FF",
          "defaultChannel": "task-reminders",
          "sounds": []
        }
      ],
      "@sentry/react-native",
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Planora reads your calendar to show today's events alongside your assignments."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b06573e3-d986-4a3f-9fc5-704de3962c20"
      }
    }
  }
}
