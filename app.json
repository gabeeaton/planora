{
  "expo": {
    "name": "TaskFlow",
    "slug": "taskflow",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.taskflow",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "scheme": "planora"
    },
    "android": {
      "package": "com.yourcompany.taskflow",
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE", "POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "planora" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "scheme": "planora",
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C63FF",
          "defaultChannel": "task-reminders",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "firebaseApiKey":            "$FIREBASE_API_KEY",
      "firebaseAuthDomain":        "$FIREBASE_AUTH_DOMAIN",
      "firebaseProjectId":         "$FIREBASE_PROJECT_ID",
      "firebaseStorageBucket":     "$FIREBASE_STORAGE_BUCKET",
      "firebaseMessagingSenderId": "$FIREBASE_MESSAGING_SENDER_ID",
      "firebaseAppId":             "$FIREBASE_APP_ID",
      "openaiApiKey":              "$OPENAI_API_KEY"
    }
  }
}